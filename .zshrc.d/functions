# helpful functions
function passgen() {
  if [ $# -ne 1 ]; then
    echo "ARGS: <length>"
  else
    pwgen -s $1 1 | tr -d '\n' | pbcopy && pbpaste && echo -e "\n==> Sent to clipboard"
  fi
}

