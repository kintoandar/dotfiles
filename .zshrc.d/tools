# Everything here defines zle widgets or binds keys. syntax-highlighting has to
# wrap them and the custom bindkeys have to come after them -- both live in
# interactive.

source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

eval "$(zoxide init zsh)"     # z <partial-dir-name> to jump
source <(fzf --zsh)           # Ctrl-R history, Ctrl-T files

# Provide preview window
export FZF_CTRL_T_OPTS="
  --preview 'bat -n --color=always {}'
  --preview-window right:60%"

# mise, replacing pyenv (2026-09-05). `activate` puts the shims dir on PATH and
# installs a precmd hook that, on every cd, prepends the active install bin and
# applies mise.toml env like a project .venv. `--shims` drops that hook, not the
# shims -- it is not the always-on switch. This file is interactive-only, so
# cron, a LaunchAgent or a GUI app would need the shims dir on PATH from
# .zshenv. Nothing here runs python that way.
eval "$(mise activate zsh)"
